{
  "expo": {
    "name": "GERETOU",
    "slug": "geretou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.geretou.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "GERETOU utilise Face ID pour sécuriser l'accès à vos données financières."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B4F3A"
      },
      "package": "com.geretou.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser GERETOU à utiliser Face ID pour déverrouiller vos comptes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B4F3A"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "6a5bd6e6-7754-4b3e-86e8-e6335a935c85"
      }
    },
    "owner": "krsidoine"
  }
}
