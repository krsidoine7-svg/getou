{
  "name": "geretou",
  "version": "1.0.0",
  "description": "GERETOU - Application Mobile de Gestion Financière & Domestique Offline-First",
  "main": "index.ts",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./start.ps1",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build -p android --profile preview",
    "build:prod": "eas build -p android --profile production"
  },
  "dependencies": {
    "@babel/runtime": "^8.1.0",
    "@expo/metro-runtime": "^58.0.17",
    "@noble/hashes": "^2.4.0",
    "expo": "~58.0.23",
    "expo-auth-session": "~58.0.17",
    "expo-crypto": "~58.0.7",
    "expo-haptics": "~58.0.7",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.71.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.3.0",
    "typescript": "^6.0.3"
  },
  "private": true
}
